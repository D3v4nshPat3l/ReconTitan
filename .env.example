# ReconTitan environment template
# Copy to .env. Never commit the populated .env file.

# Application
RECONTITAN_DEBUG=true
DOMAIN=localhost
SECRET_KEY=
API_ACCESS_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1
ALLOW_PRIVATE_TARGETS=false
ENABLE_ACTIVE_VULN_TOOLS=false
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_BURST=30
RATE_LIMIT_SCAN=5
RATE_LIMIT_DANGER=2
RATE_LIMIT_API=120
RATE_LIMIT_EXPORT=10
RATE_LIMIT_BLOCK_SECONDS=300

# ── Danger Mode (full intermediate penetration test simulation) ──
# Danger Mode sends bounded, non-destructive attack-simulation traffic:
# injection probes, directory and traversal fuzzing, identifier enumeration,
# and DNS zone-transfer attempts. Enable it ONLY for systems you own or have
# explicit written permission to assess. Every request also requires the typed
# acknowledgement "I am authorized" from the operator.
# Deep port scanning. Every one of the 65535 TCP ports, full version probing,
# and the NSE vuln script category.
#
# Off by default and deliberately so: it is loud, takes minutes rather than
# seconds, and NSE vuln scripts actively probe for weaknesses rather than
# merely observing. Turn it on only where you would be comfortable running
# nmap by hand against the same target. Requires nmap to be installed.
NMAP_DEEP_SCAN=false
SCAN_TIMEOUT_NMAP_DEEP=900
# nmap --version-intensity, 0-9. Higher sends more probes per open port.
NMAP_VERSION_INTENSITY=7
# TCP ports a deep scan covers. Accepts any nmap -p expression, so 1-20000,
# 1-65535 or 22,80,443 all work. The default stops at 20000 because every
# open port also gets version probes and the full NSE set: an all-ports
# sweep runs past SCAN_TIMEOUT_NMAP_DEEP, and a timed-out scan reports
# nothing at all.
NMAP_DEEP_PORTS=1-10000
# Note MongoDB (27017) and Elasticsearch (9300) sit above 10000. Name them
# if you want them: "1-10000,9300,27017".
#
# NSE scripts a deep scan runs. A named list of 50 rather than a category
# expression: categories are far too broad (`default` alone is 100+ scripts,
# some of which walk hundreds of URL paths per HTTP port) and `all` includes
# broadcast-* scripts, which run before the target is touched and enumerate
# YOUR OWN network into the report. Every script below is detection-only.
# Any nmap --script expression works here. Check one first:
#     nmap --script-help "<expression>"
NMAP_DEEP_SCRIPTS=ssl-cert,ssl-enum-ciphers,ssl-date,ssl-dh-params,ssl-heartbleed,ssl-poodle,ssl-ccs-injection,sslv2-drown,tls-alpn,http-title,http-headers,http-server-header,http-methods,http-security-headers,http-robots.txt,http-git,http-open-proxy,http-cors,http-cookie-flags,http-webdav-scan,http-auth,http-internal-ip-disclosure,http-trace,http-generator,http-vuln-cve2017-5638,ssh-hostkey,ssh2-enum-algos,ssh-auth-methods,dns-recursion,dns-nsid,dns-zone-transfer,smb-os-discovery,smb-security-mode,smb2-security-mode,smb-protocols,smb-vuln-ms17-010,mysql-info,mysql-empty-password,ms-sql-info,mongodb-info,redis-info,smtp-commands,smtp-open-relay,imap-capabilities,ftp-anon,ftp-syst,rdp-ntlm-info,rdp-enum-encryption,vnc-info,banner
# Where a deep scan writes its -oA artifacts (.nmap/.gnmap/.xml).
# Empty means do not write them: raw scan output of someone else's
# infrastructure should not land on disk by accident.
NMAP_OUTPUT_DIR=

# Danger Mode always uses the deep profile regardless of NMAP_DEEP_SCAN.
# Depth follows the authorisation gate, so a plain Full scan keeps the
# bounded traffic its description promises.

ALLOW_DANGER_MODE=true
DANGER_MODE_MAX_TARGETS=1
DANGER_MAX_HOSTS=5
DANGER_MAX_REQUESTS_TOTAL=500
DANGER_MAX_REQUESTS_PER_MODULE=80
DANGER_MAX_PAYLOADS_PER_SCAN=400
DANGER_MAX_ENDPOINTS=15
DANGER_MAX_CRAWL_PAGES=10
DANGER_REQUEST_DELAY_MS=150
# Hard wall-clock ceiling for the danger phase. Stages still pending when this
# elapses are skipped and the report is built from completed work, so a scan
# can never leave the caller waiting with no result.
DANGER_MAX_SCAN_SECONDS=240
DANGER_REQUEST_TIMEOUT=12
DANGER_TIME_DELAY_SECONDS=2
DANGER_SUBDOMAIN_BRUTE_LIMIT=100
DANGER_DIR_BUST_WORDLIST=120
DANGER_IDOR_MAX_IDS=10
DANGER_ENABLE_XXE_OOB=false

# Scan performance and pipeline ceilings
# Independent, network-bound recon and OSINT tools run concurrently. Set to 1 to
# restore strictly sequential execution.
SCAN_TOOL_CONCURRENCY=8
# Whole-pipeline ceiling for one scan. Leave blank to derive it from the tool
# timeouts and DANGER_MAX_SCAN_SECONDS, which is the safe default: the danger
# profile runs every phase inside one worker task, and a ceiling below the sum
# of those phases kills the scan before the danger stages ever run.
SCAN_SOFT_TIME_LIMIT=
# Per-tool Celery ceiling for the individual phase tasks.
CELERY_TASK_TIME_LIMIT=900
# Keep-alive connections retained per worker. Reusing a pinned connection avoids
# a TCP and TLS handshake on every probe. 0 disables reuse.
HTTP_POOL_MAX_IDLE=16
# Seconds a validated DNS resolution is reused. Caching widens the DNS-rebinding
# window that per-request pinning closes, so keep this short. 0 disables the
# cache and restores per-request revalidation.
DNS_CACHE_TTL_SECONDS=30

# API / browser access
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MongoDB
MONGO_ROOT_USER=recontitan_root
MONGO_ROOT_PASS=
# A managed provider gives one connection string. It wins over the host/port
# parts below, and it is the only way to express Atlas's mongodb+srv:// scheme.
# Required for any serverless deployment — a function has no localhost.
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/recontitan?retryWrites=true&w=majority

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=recontitan
MONGO_USER=
MONGO_PASS=
MONGO_AUTH_SOURCE=recontitan

# ── API authentication ────────────────────────────────────────────────────
# One shared secret. Still fully supported and unchanged.
# API_ACCESS_KEY=

# Optional: named keys, so callers can be told apart in the audit trail and one
# can be revoked without cutting off the rest. Format: label:secret,label:secret
# The label is an audit handle only -- these are still all-or-nothing
# credentials with no roles. Both variables can be used together; a key set via
# API_ACCESS_KEY is recorded as "default".
# API_ACCESS_KEYS=ci:<32+ char secret>,scanner-ui:<32+ char secret>

# Trust X-Forwarded-For for the client address. Leave unset: it defaults on
# only under SERVERLESS, where nothing else can supply a real client IP and
# every visitor would otherwise be logged as the platform's own proxy. Setting
# it true behind anything that does not overwrite the header lets a client
# forge its own source address in the audit trail.
# TRUST_PROXY_HEADERS=

# Rotating the admin token without a flag day: put the OLD token here, deploy
# the new ADMIN_TOKEN, watch the log for "authenticated with
# ADMIN_TOKEN_PREVIOUS", then clear this once nothing legitimate uses it.
# ADMIN_TOKEN_PREVIOUS=

# Network allowlist for the admin console, as addresses or CIDR ranges.
# Empty means unrestricted. When set, a caller outside the list never reaches
# the token check, so the token stops being the only control.
#
# An SSH tunnel arrives as 127.0.0.1, so include loopback if you reach the
# console that way — the app warns at startup if you have not.
# ADMIN_IP_ALLOWLIST=127.0.0.1/32,10.8.0.0/24

# ── Third-party lookups ───────────────────────────────────────────────────
# Even with no API keys set, a default scan contacts these services and they
# necessarily learn the target you are scanning:
#   crt.sh          — certificate transparency (subdomain + takeover input)
#   ipinfo.io       — IP geolocation and ASN
#   web.archive.org — historical URL discovery
# Those three are intrinsic to the modules named after them and appear as the
# tool name on every finding they produce.
#
# api.hackertarget.com is different: it was an invisible fallback behind the
# port scan and the reverse-IP lookup. It is off by default. Turning it on
# discloses the target address to a third party, which your scan authorization
# may not cover. When off, the port scan reports that it did not run rather
# than reporting no open ports.
ALLOW_HACKERTARGET=false

# ── AI narration layer ────────────────────────────────────────────────────
# The scanners are pure Python; AI only *explains* findings they produce.
# auto = local Ollama if reachable, else OpenAI if keyed, else static text.
AI_PROVIDER=auto

# Ollama (local, free, no API key, nothing leaves the host).
# Bare-metal backend  -> http://localhost:11434
# Backend in Docker   -> http://host.docker.internal:11434 (Ollama on the host)
#                     -> http://ollama:11434 (the bundled compose service)
OLLAMA_BASE_URL=http://localhost:11434
# Leave blank to auto-pick the first installed model.
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m

# How much narration a single scan may spend on per-finding explanations.
# Each explanation is one model round-trip; these are hard ceilings.
AI_MAX_FINDING_EXPLANATIONS=8
AI_EXPLANATION_BUDGET_SECONDS=90
AI_EXPLANATION_CONCURRENCY=2

# Optional hosted fallback, used only when Ollama is unreachable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scanner limits (seconds / bounded workload)
SCAN_TIMEOUT_NMAP=300
SCAN_TIMEOUT_NUCLEI=600
SCAN_TIMEOUT_DEFAULT=120
JS_ANALYSIS_MAX_FILES=20
JS_ANALYSIS_MAX_BYTES=1048576
TAKEOVER_MAX_SUBDOMAINS=150

# Optional threat-intelligence APIs
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GREYNOISE_API_KEY=
SECURITYTRAILS_API_KEY=
URLSCAN_API_KEY=
INTELX_API_KEY=

# NVD CVE matching. Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD allows only 5 requests per 30s and returns 403s that look
# identical to "no vulnerabilities found", so a key improves CVE accuracy.
NVD_API_KEY=
NVD_MAX_PRODUCTS=5

# ── Serverless / Vercel deployment ──────────────────────────────────────────
# Vercel sets VERCEL=1 automatically, so SERVERLESS is detected without help.
# Set it manually only for another platform that runs many short-lived
# instances. In this mode POST /api/scan is refused (no Celery worker exists)
# and the UI uses the synchronous /api/test-scan endpoint instead.
SERVERLESS=

# Rate limits and admin lockout live in process memory by default, which is
# correct for one process and WRONG for many: N instances mean N x the
# configured ceiling, and admin brute-force protection can be sidestepped by
# landing on a fresh instance. Point this at a managed Redis for any
# multi-instance deployment. Required on Vercel.
REDIS_URL=
SHARED_STATE_ENABLED=
